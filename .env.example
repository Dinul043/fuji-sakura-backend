# ═══════════════════════════════════════════════════════════════════
# Fuji Sakura Food Delivery — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── App Configuration ──────────────────────────────────────────────
APP_NAME=Fuji Sakura Food Delivery
DEBUG=True

# ── Database Configuration ─────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fuji_sakura_db

# ── JWT / Auth Configuration ───────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# ── Email Configuration (Mailtrap for dev, SendGrid/SES for prod) ──
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@fujisakura.com
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525

# ── Razorpay Payment Gateway ──────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
PAYMENT_MODE=razorpay

# ── OTP Configuration ─────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
RESET_TOKEN_EXPIRE_MINUTES=30
